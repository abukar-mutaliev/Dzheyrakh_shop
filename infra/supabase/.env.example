TZ=Europe/Moscow

POSTGRES_PASSWORD=change-me
POSTGRES_USER=postgres
POSTGRES_DB=postgres
POSTGRES_HOST=db
POSTGRES_PORT=5432

JWT_SECRET=change-me
JWT_EXPIRY=3600
ANON_KEY=change-me
SERVICE_ROLE_KEY=change-me

# Public hostnames. DNS A-records must point at this VPS before the first start.
API_DOMAIN=api.example.ru
SHOP_DOMAIN=shop.example.ru
SITE_URL=https://shop.example.ru
API_EXTERNAL_URL=https://api.example.ru/auth/v1
ADDITIONAL_REDIRECT_URLS=https://shop.example.ru

PGRST_DB_SCHEMAS=public

# Buyers check out as guests. Public signup stays off. GoTrue still serves /auth/v1.
DISABLE_SIGNUP=true
ENABLE_EMAIL_SIGNUP=false
ENABLE_PHONE_SIGNUP=false
ENABLE_ANONYMOUS_USERS=false
ENABLE_EMAIL_AUTOCONFIRM=false
ENABLE_PHONE_AUTOCONFIRM=false
